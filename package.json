{
  "name": "keeperhq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-players-nhl.mjs && vite build",
    "preview": "vite preview",
    "players:nhl": "node scripts/fetch-players-nhl.mjs",
    "test:parser": "node scripts/test-draft-parser.mjs && node scripts/test-roster-parser.mjs",
    "test:rules": "esbuild src/CreateLeagueWizard.jsx --bundle --format=esm --outfile=.tmp-wizard-bundle.mjs --loader:.jsx=jsx --external:react --external:react-dom --log-level=error && node scripts/test-keeper-rules.mjs",
    "test:wizard": "esbuild src/CreateLeagueWizard.jsx --bundle --format=esm --outfile=.tmp-wizard-bundle.mjs --loader:.jsx=jsx --external:react --external:react-dom --log-level=error && node scripts/smoke-wizard.mjs",
    "test": "npm run test:parser && npm run test:rules && npm run test:wizard"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.10"
  }
}
